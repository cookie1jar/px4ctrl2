Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: vio_odom
    Background Color: 35; 35; 35
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Observed Surfaces (no inflation)
      Enabled: true
      Topic:
        Value: /ego/occupancy
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Alpha: 0.8
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 185; 195; 205
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Planning Safety Margin (inflated)
      Enabled: false
      Topic:
        Value: /ego/occupancy_inflate
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Alpha: 0.18
      Size (m): 0.045
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 80; 165; 230
      Value: false
    - Class: rviz_default_plugins/Marker
      Name: EGO Planned Trajectory
      Enabled: true
      Topic:
        Value: /ego/planned_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Value: true
    - Class: rviz_default_plugins/Path
      Name: OpenVINS Flown Path (yellow)
      Enabled: true
      Topic:
        Value: /openvins/flight_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.04
      Color: 255; 220; 40
      Alpha: 1
      Pose Style: None
      Value: true
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 120; 120; 120
      Value: true
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: Editable 3D Target
      Enabled: true
      Interactive Markers Namespace: /rviz_goal/interactive_target
      Show Axes: true
      Show Descriptions: true
      Show Visual Aids: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: OpenVINS Vehicle
      Enabled: true
      Topic:
        Value: /openvins/body_odom
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape: Arrow
      Color: 40; 220; 100
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shaft Length: 0.4
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.1
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Selected Target
      Enabled: true
      Topic:
        Value: /rviz_goal/target
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: vio_odom
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 850
